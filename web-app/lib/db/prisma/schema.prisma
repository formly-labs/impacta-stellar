datasource db {
  provider = "postgresql"
}

generator client {
  provider   = "prisma-client"
  output     = "../prisma/generated"
  engineType = "client"
}

model Workspace {
  id               String             @id @default(cuid())
  name             String
  description      String?
  ownerAddress     String
  linkAccess       LinkAccess         @default(RESTRICTED) // "RESTRICTED" o "ANYONE_WITH_LINK"
  linkPermission   Permission         @default(VIEWER) // "VIEWER" o "EDITOR"
  forms            Form[]
  members          WorkspaceMember[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

model WorkspaceMember {
  id            String     @id @default(cuid())
  workspaceId   String
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  walletAddress String
  permission    Permission @default(VIEWER) // "VIEWER" o "EDITOR"
  createdAt     DateTime   @default(now())

  @@unique([workspaceId, walletAddress])
}

model Form {
  id                  String     @id @default(cuid())
  slug                String
  title               String
  description         String?
  ownerAddress        String
  budget              Float      @default(0) // En XLM
  isActive            Boolean    @default(true)
  isArchived          Boolean    @default(false)
  theme               String? // "Product UX", "Segmentation", "Sales"
  rewardPerGoodAnswer Float? // XLM por respuesta válida
  workspaceId         String?
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  fields              Field[]
  responses           Response[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

model Response {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers   Json // { [fieldId: string]: string | string[] }
  createdAt DateTime @default(now())
}

model Field {
  id          String   @id @default(cuid())
  type        String // "text", "email", "phone", "radio", "checkbox", "short_text", "long_text"
  label       String
  placeholder String?
  required    Boolean  @default(false)
  options     String[] @default([]) // Opciones para radio/checkbox
  allowOther  Boolean  @default(false)
  formId      String
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  firstName     String?
  lastName      String?
  email         String?
  phone         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum LinkAccess {
  RESTRICTED          // Solo miembros invitados
  ANYONE_WITH_LINK    // Cualquiera con el link
}

enum Permission {
  VIEWER              // Solo lectura
  EDITOR              // Editar
}
