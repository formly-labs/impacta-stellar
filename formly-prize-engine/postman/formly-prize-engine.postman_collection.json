{
  "info": {
    "name": "formly-prize-engine",
    "description": "API v1 — prizes, entries, close, distribute, result (reales). payment-intent y jobs/tick siguen stub 501.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "serviceToken", "value": "" },
    { "key": "prizeId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Create Prize (POINTS)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rewardType\": \"POINTS\",\n  \"distributionMode\": \"SPLIT_EQUAL\",\n  \"prizeAmount\": \"60.0000000\",\n  \"closeAt\": \"2025-03-01T12:00:00.000Z\",\n  \"drawAt\": \"2025-03-02T12:00:00.000Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/prizes"
      }
    },
    {
      "name": "2. Create Prize (USDC)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rewardType\": \"USDC\",\n  \"distributionMode\": \"LOTTERY_SINGLE\",\n  \"prizeAmount\": \"100.0000000\",\n  \"feeBps\": 1000,\n  \"closeAt\": \"2025-03-01T12:00:00.000Z\",\n  \"drawAt\": \"2025-03-02T12:00:00.000Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/prizes"
      }
    },
    {
      "name": "3. Get Prize",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}"
      }
    },
    {
      "name": "6. Close Prize",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/close"
      }
    },
    {
      "name": "4. Add Entry",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"walletAddress\": \"GCT7D6S5VTFGEURS6ZYIO33YZRPQMA3LNWB4GEOHDFDXZGWTA4EPIM5E\",\n  \"sourceId\": \"resp_01\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/entries"
      }
    },
    {
      "name": "5. List Entries",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/entries?limit=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "prizes", "{{prizeId}}", "entries"],
          "query": [
            { "key": "limit", "value": "20" },
            { "key": "cursor", "value": "", "disabled": true }
          ]
        }
      }
    },
    {
      "name": "7. Distribute",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/distribute"
      }
    },
    {
      "name": "8. Result",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/result"
      }
    },
    {
      "name": "9. Payment Intent (stub 501)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/payment-intent"
      }
    },
    {
      "name": "10. Jobs Tick (stub 501)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"runMode\": \"execute\",\n  \"maxPrizes\": 50\n}"
        },
        "url": "{{baseUrl}}/api/v1/jobs/tick"
      }
    }
  ]
}
