{
  "info": {
    "name": "formly-prize-engine",
    "description": "API v1 — prizes, entries, stubs (payment-intent, distribute, result, jobs/tick)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "serviceToken", "value": "" },
    { "key": "prizeId", "value": "" }
  ],
  "item": [
    {
      "name": "Create Prize",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"formId\": \"form_01\",\n  \"creatorId\": \"user_01\",\n  \"rewardType\": \"USDC\",\n  \"distributionMode\": \"LOTTERY_SINGLE\",\n  \"amount\": \"100.0000000\",\n  \"feeBps\": 1000,\n  \"closeAt\": \"2025-03-01T12:00:00.000Z\",\n  \"drawAt\": \"2025-03-02T12:00:00.000Z\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/prizes"
      }
    },
    {
      "name": "Get Prize",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}"
      }
    },
    {
      "name": "Add Entry",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"walletAddress\": \"GABC123...\",\n  \"sourceId\": \"resp_01\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/entries"
      }
    },
    {
      "name": "List Entries",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/entries?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "prizes", "{{prizeId}}", "entries"],
          "query": [{ "key": "limit", "value": "50" }]
        }
      }
    },
    {
      "name": "Payment Intent (stub)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/payment-intent"
      }
    },
    {
      "name": "Distribute (stub)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{}" },
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/distribute"
      }
    },
    {
      "name": "Result (stub)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/prizes/{{prizeId}}/result"
      }
    },
    {
      "name": "Jobs Tick (stub)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"runMode\": \"execute\",\n  \"maxPrizes\": 50\n}"
        },
        "url": "{{baseUrl}}/api/v1/jobs/tick"
      }
    }
  ]
}
